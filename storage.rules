rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence-media/{allPaths=**} {
      // Public read of verified civic evidence media
      allow read: if true;
      // Allow upload if image and under 15MB
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
