# ========================================================
# CivicTwin + ProofMesh Environment Configuration
# ========================================================

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key (Optional)
# If provided, enables live server-side Google Generative AI extraction.
# If omitted or unavailable, CivicTwin operates in resilient local heuristic NLP mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional for cloud production deployment)
FIREBASE_PROJECT_ID=civictwin-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@civictwin-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Node Environment
NODE_ENV=development
